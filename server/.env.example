# Server
PORT=3000
NODE_ENV=development

# OpenRouter user key is entered in the UI, kept only in an encrypted HttpOnly session cookie.
OPENROUTER_SPEND_LIMIT_PER_OP_USD=0.10
# Required in production; encryption secret is NOT an OpenRouter key (32+ chars).
SESSION_SECRET=
# Required in production for this personal/shared workspace (16+ chars).
APP_ACCESS_PASSWORD=

# LLM request behaviour
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_MS=1500

# Storage: file | supabase
STORAGE_DRIVER=file
DATA_DIR=./data

# Supabase (for cloud deploys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sites

# App
APP_BASE_URL=http://localhost:3000

# Set to true to use mock LLM responses (no API calls, no cost)
MOCK_LLM=true

# Optional, only for OpenRouter. Direct networking is the default on Render.
# No sing-box service is required. Generic HTTP_PROXY/HTTPS_PROXY are not used.
OPENROUTER_PROXY_URL=
